# Copy to apps/web/.env.local for development. Never commit real values.
NEXT_PUBLIC_APP_URL=http://localhost:3600
NEXT_PUBLIC_APP_NAME=Punchcard

# Postgres (Neon). Leave empty for embedded PGlite in development (.pglite/, migrated on first use).
# Production: pooled URL here; run `pnpm db:migrate` with the direct URL. Tables live in schema "punchcard".
DATABASE_URL=

# Better Auth. Generate with: openssl rand -base64 32. Required in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Background jobs (Vercel cron calls /api/cron/daily with Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# RevenueCat webhook: the dashboard sends Authorization: Bearer <this value>
REVENUECAT_WEBHOOK_SECRET=

# Optional: Expo access token if "enhanced push security" is turned on for the Expo project.
EXPO_ACCESS_TOKEN=
